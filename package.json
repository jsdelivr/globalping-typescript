{
	"name": "globalping",
	"version": "0.3.0",
	"license": "MIT",
	"description": "The official TS/JS client for the Globalping API",
	"keywords": [
		"globalping",
		"ping",
		"traceroute",
		"dns",
		"mtr",
		"http"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"import": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.js"
		},
		"require": {
			"types": "./dist/cjs/bundle.d.cts",
			"default": "./dist/cjs/bundle.cjs"
		},
		"default": "./dist/umd/bundle.js"
	},
	"jsdelivr": "./dist/umd/bundle.min.js",
	"types": "./dist/umd/bundle.d.ts",
	"files": [
		"dist",
		"src"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/jsdelivr/globalping-typescript.git"
	},
	"bugs": {
		"url": "https://github.com/jsdelivr/globalping-typescript/issues"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@hey-api/openapi-ts": "0.99.0",
		"@martin-kolarik/eslint-config": "^9.0.1",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@tsconfig/strictest": "^2.0.8",
		"@types/chai": "^5.2.3",
		"@types/jsdom": "^28.0.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.1.2",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"chai": "^6.2.2",
		"conventional-changelog-conventionalcommits": "^10.2.1",
		"eslint": "^10.8.0",
		"fetch-mock": "^12.6.0",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"mocha": "^11.7.6",
		"prettier": "^3.9.6",
		"rollup": "^4.62.3",
		"rollup-plugin-dts": "^6.4.1",
		"semantic-release": "^25.0.8",
		"terser": "^5.49.0",
		"ts-node": "^10.9.2",
		"ts-patch": "^4.0.1",
		"typescript": "^6.0.3",
		"typescript-transform-paths": "^4.0.0"
	},
	"overrides": {
		"js-yaml": "4.3.0"
	},
	"scripts": {
		"build": "rm -rf dist && npm run build:esm && npm run build:cjs-umd",
		"build:esm": "tspc --declaration",
		"build:cjs-umd": "rollup -c && terser dist/umd/bundle.js -o dist/umd/bundle.min.js --source-map 'content=dist/umd/bundle.js.map,url=bundle.min.js.map'",
		"lint": "eslint --cache .",
		"lint:fix": "eslint --cache --fix .",
		"openapi:generate": "openapi-ts && prettier --config openapi-ts.prettier.config.js --write src/openapi-ts && (eslint --no-ignore --fix src/openapi-ts > /dev/null || exit 0)",
		"prepare": "husky || echo 'Failed to install husky'",
		"test:dist": "node test/dist.js",
		"test:e2e": "TS_NODE_TRANSPILE_ONLY=true mocha --config .mocharc.e2e.cjs",
		"test:integration": "TS_NODE_TRANSPILE_ONLY=true mocha",
		"test": "npm run lint && npm run test:integration"
	},
	"engines": {
		"node": ">=22.22.2"
	}
}
